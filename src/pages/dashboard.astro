---
import Layout from "../layouts/Layout.astro";
import DashboardLayout from "../components/DashboardLayout";

export const prerender = false;

// User is guaranteed to be present due to middleware protection
const { user } = Astro.locals;

if (!user) {
  // This should never happen due to middleware, but handle it gracefully
  return Astro.redirect("/auth/signin");
}
---

<Layout title="Dashboard - Kanji Quiz">
  <main>
    <DashboardLayout client:load userEmail={user.email} />
  </main>
</Layout>

<style>
  main {
    width: 100%;
    min-height: 100vh;
  }
</style>
