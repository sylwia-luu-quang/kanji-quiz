---
import Layout from "../../layouts/Layout.astro";
import SignUpForm from "../../components/SignUpForm";

export const prerender = false;

// Check for existing session and redirect authenticated users to dashboard
const { user } = Astro.locals;

// Extract redirect parameter from query string for post-signup navigation
const redirectTo = Astro.url.searchParams.get("redirect") || "/dashboard";

if (user) {
  // User is already authenticated, redirect to specified page or dashboard
  return Astro.redirect(redirectTo);
}
---

<Layout title="Sign Up - Kanji Quiz">
  <div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12">
    <SignUpForm client:load redirectTo={redirectTo} />
  </div>
</Layout>
