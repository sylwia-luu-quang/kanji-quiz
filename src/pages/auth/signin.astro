---
import Layout from "../../layouts/Layout.astro";
import SignInForm from "../../components/SignInForm";

export const prerender = false;

// Check for existing session and redirect authenticated users to dashboard
const { user } = Astro.locals;

if (user) {
  // User is already authenticated, redirect to dashboard
  const redirectTo = Astro.url.searchParams.get("redirect") || "/dashboard";
  return Astro.redirect(redirectTo);
}

// Extract redirect parameter from query string for post-login navigation
const redirectTo = Astro.url.searchParams.get("redirect") || "/dashboard";
---

<Layout title="Sign In - Kanji Quiz">
  <div class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-12">
    <SignInForm client:load redirectTo={redirectTo} />
  </div>
</Layout>
